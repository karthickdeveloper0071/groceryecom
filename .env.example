# Copy to .env and edit. Docker Compose reads .env automatically; .env is git-ignored.

# Required when running the API in Docker (docker compose --profile app).
# At least 64 characters. Generate one, for example:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Database. Two roles, on purpose:
#   DB_USERNAME  owns the schema and runs Flyway migrations (DDL)
#   grocery_app  is what the API connects as: rows only, no schema changes
# The runtime role is created by ops/postgres/init on first start of an empty volume,
# with the password below.
DB_NAME=grocery_ecom
DB_USERNAME=grocery
DB_PASSWORD=grocery
APP_DB_PASSWORD=grocery_app

# RabbitMQ
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Comma-separated browser origin PATTERNS allowed to call the API.
# "*" replaces one host label, so https://*.groceryecom.com covers every vendor
# storefront subdomain. A vendor on its own domain must be listed explicitly.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Grafana (only used by docker-compose.observability.yml)
GRAFANA_PASSWORD=admin
